# Metamorph configuration - copy to .env, then restart `npm start` after changes.

# --- Network -----------------------------------------------------------
# 0.0.0.0   = reachable from other devices on your local network (LAN)
# 127.0.0.1 = this computer only
HOST=0.0.0.0
# Port other devices connect to: http://<this-computer-ip>:3000
PORT=3000

# --- Ollama ------------------------------------------------------------
# Ollama runs on this same computer. Leave it on localhost:
# only Metamorph talks to Ollama, so port 11434 stays private.
OLLAMA_URL=http://127.0.0.1:11434

# --- Security ----------------------------------------------------------
# Required when HOST is not localhost. At least 12 characters.
APP_PASSWORD=change-me-to-a-long-password
# false = plain http:// on your LAN (required, or sign-in won't stick).
# true  = only when served over HTTPS (reverse proxy, Tailscale HTTPS...).
COOKIE_SECURE=false
